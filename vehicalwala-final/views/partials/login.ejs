<div id="loginModal" class="hidden fixed inset-0 z-[60] bg-black/50 items-center"><form id="loginForm" class="m-auto w-[calc(100%-32px)] max-w-sm bg-white rounded-xl shadow-xl p-8 flex flex-col gap-4"><div class="flex justify-between"><h2 id="authTitle" class="text-2xl font-semibold">Login</h2><button type="button" id="closeLogin">✕</button></div><input id="authName" class="border p-3 rounded hidden" placeholder="Full Name"><input id="authEmail" type="email" class="border p-3 rounded" placeholder="example@gmail.com" required><div class="relative"><input id="authPassword" type="password" class="border p-3 rounded w-full" placeholder="Password" required><button type="button" id="togglePassword" class="absolute right-3 top-3">👁️</button></div><input id="dashboardKey" class="border p-3 rounded hidden" placeholder="Dashboard key (owner only)"><a id="forgotLink" href="/forgot-password" class="text-sm text-right text-blue-600">Forgot password?</a><p class="text-sm text-center"><span id="authSwitchText">Create account?</span> <button type="button" id="authSwitch" class="text-blue-600">click here</button></p><button class="bg-blue-600 text-white py-3 rounded" id="authSubmit">Login</button></form></div>
