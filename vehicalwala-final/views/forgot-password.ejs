<%- include('partials/head', { title: title }) %>

<%- include('partials/navbar') %>

<main class="min-h-[70vh] flex items-center justify-center bg-gray-50">

    <form
        id="forgotForm"
        class="bg-white p-8 shadow rounded w-[calc(100%-32px)] max-w-sm"
    >

        <h2 class="text-xl font-semibold text-center mb-4">
            Forgot Password
        </h2>

        <input
            name="email"
            type="email"
            placeholder="Enter your email"
            class="w-full p-3 border rounded mb-4"
            required
        >

        <button
            class="w-full bg-blue-600 text-white py-3 rounded"
        >
            Send Reset Link
        </button>

        <p
            id="forgotResult"
            class="text-sm mt-4"
        ></p>

    </form>

</main>

<%- include('partials/footer') %>