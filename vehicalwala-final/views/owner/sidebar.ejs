<!-- =========================================================
     SIDEBAR JAVASCRIPT
========================================================= -->

<script>

(function () {

    /* =====================================================
       ELEMENTS
    ====================================================== */

    const menuButton =
        document.getElementById(
            "ownerMenuBtn"
        );


    const sidebar =
        document.getElementById(
            "ownerHamburgerSidebar"
        );


    const overlay =
        document.getElementById(
            "ownerSidebarOverlay"
        );


    const closeButton =
        document.getElementById(
            "ownerSidebarClose"
        );


    /* =====================================================
       OPEN SIDEBAR
    ====================================================== */

    function openOwnerSidebar() {

        if (
            !sidebar ||
            !overlay
        ) {
            return;
        }

        sidebar.classList.remove(
            "-translate-x-full"
        );

        overlay.classList.remove(
            "hidden"
        );

        document.body.classList.add(
            "overflow-hidden"
        );

    }


    /* =====================================================
       CLOSE SIDEBAR
    ====================================================== */

    function closeOwnerSidebar() {

        if (
            !sidebar ||
            !overlay
        ) {
            return;
        }

        sidebar.classList.add(
            "-translate-x-full"
        );

        overlay.classList.add(
            "hidden"
        );

        document.body.classList.remove(
            "overflow-hidden"
        );

    }


    /* =====================================================
       HAMBURGER BUTTON
    ====================================================== */

    if (menuButton) {

        menuButton.addEventListener(
            "click",
            openOwnerSidebar
        );

    }


    /* =====================================================
       CLOSE BUTTON
    ====================================================== */

    if (closeButton) {

        closeButton.addEventListener(
            "click",
            closeOwnerSidebar
        );

    }


    /* =====================================================
       OVERLAY CLICK
    ====================================================== */

    if (overlay) {

        overlay.addEventListener(
            "click",
            closeOwnerSidebar
        );

    }


    /* =====================================================
       MENU CLICK
    ====================================================== */

    document
        .querySelectorAll(
            ".owner-menu-link"
        )
        .forEach(
            function (link) {

                link.addEventListener(
                    "click",
                    closeOwnerSidebar
                );

            }
        );


    /* =====================================================
       
    ====================================================== */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape"
            ) {

                closeOwnerSidebar();

            }

        }
    );


    /* =====================================================
       
    ====================================================== */

    const currentPath =
        window.location.pathname;


    document
        .querySelectorAll(
            ".owner-link"
        )
        .forEach(
            function (link) {

                const path =
                    link.getAttribute(
                        "data-path"
                    );


                if (!path) {
                    return;
                }


                let isActive =
                    false;


                /* Dashboard */

                if (
                    path === "/owner"
                ) {

                    isActive =
                        currentPath ===
                            "/owner" ||
                        currentPath ===
                            "/owner/";

                }


                /* Other pages */

                else {

                    isActive =
                        currentPath ===
                            path ||
                        currentPath.startsWith(
                            path + "/"
                        );

                }


                if (isActive) {

                    link.classList.add(
                        "bg-blue-50",
                        "text-blue-600"
                    );

                }

            }
        );


    /* =====================================================
    
    ====================================================== */

    const navOwnerName =
        document.getElementById(
            "ownerName"
        );


    const sidebarOwnerName =
        document.getElementById(
            "ownerSideName"
        );


    if (
        navOwnerName &&
        sidebarOwnerName
    ) {

        sidebarOwnerName.textContent =
            navOwnerName.textContent ||
            "Owner";


        const observer =
            new MutationObserver(
                function () {

                    sidebarOwnerName.textContent =
                        navOwnerName.textContent ||
                        "Owner";

                }
            );


        observer.observe(
            navOwnerName,
            {
                childList: true,
                characterData: true,
                subtree: true
            }
        );

    }


    /* =====================================================
       LOGOUT
    ====================================================== */

    const logoutButton =
        document.getElementById(
            "sidebarLogout"
        );


    if (logoutButton) {

        logoutButton.addEventListener(
            "click",
            function () {

                localStorage.removeItem(
                    "token"
                );

                localStorage.removeItem(
                    "user"
                );

                window.location.href = "/";

            }
        );

    }

})();

</script>