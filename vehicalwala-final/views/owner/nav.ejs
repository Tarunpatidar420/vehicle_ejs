<!-- ================================================= -->
<!-- SIDEBAR JAVASCRIPT -->
<!-- ================================================= -->

<script>

(function () {

    // =================================================
    // ELEMENTS
    // =================================================

    const menuBtn =
        document.getElementById(
            "ownerMenuBtn"
        );


    const sidebar =
        document.getElementById(
            "ownerHamburgerSidebar"
        );


    const overlay =
        document.getElementById(
            "ownerSidebarOverlay"
        );


    const closeBtn =
        document.getElementById(
            "ownerSidebarClose"
        );



    // =================================================
    // OPEN SIDEBAR
    // =================================================

    function openSidebar() {

        if (
            !sidebar ||
            !overlay
        ) {
            return;
        }


        sidebar.classList.remove(
            "-translate-x-full"
        );


        overlay.classList.remove(
            "hidden"
        );


        document.body.classList.add(
            "overflow-hidden"
        );

    }



    // =================================================
    // CLOSE SIDEBAR
    // =================================================

    function closeSidebar() {

        if (
            !sidebar ||
            !overlay
        ) {
            return;
        }


        sidebar.classList.add(
            "-translate-x-full"
        );


        overlay.classList.add(
            "hidden"
        );


        document.body.classList.remove(
            "overflow-hidden"
        );

    }



    // =================================================
    // HAMBURGER
    // =================================================

    if (menuBtn) {

        menuBtn.addEventListener(
            "click",
            openSidebar
        );

    }



    // =================================================
    // CLOSE BUTTON
    // =================================================

    if (closeBtn) {

        closeBtn.addEventListener(
            "click",
            closeSidebar
        );

    }



    // =================================================
    // OVERLAY
    // =================================================

    if (overlay) {

        overlay.addEventListener(
            "click",
            closeSidebar
        );

    }



    // =================================================
    // MENU LINKS
    // =================================================

    document
        .querySelectorAll(
            ".owner-menu-link"
        )
        .forEach(
            function (link) {

                link.addEventListener(
                    "click",
                    closeSidebar
                );

            }
        );



    // =================================================
    // ESC KEY
    // =================================================

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key === "Escape"
            ) {

                closeSidebar();

            }

        }
    );



    // =================================================
    // OWNER NAME SYNC
    // =================================================

    const ownerName =
        document.getElementById(
            "ownerName"
        );


    const sidebarOwnerName =
        document.getElementById(
            "sidebarOwnerName"
        );


    if (
        ownerName &&
        sidebarOwnerName
    ) {

        sidebarOwnerName.textContent =
            ownerName.textContent ||
            "Owner";


        const observer =
            new MutationObserver(
                function () {

                    sidebarOwnerName.textContent =
                        ownerName.textContent ||
                        "Owner";

                }
            );


        observer.observe(
            ownerName,
            {
                childList: true,
                characterData: true,
                subtree: true
            }
        );

    }



    // =================================================
    // LOGOUT FUNCTION
    // =================================================

    function logoutOwner() {

        localStorage.removeItem(
            "token"
        );


        localStorage.removeItem(
            "user"
        );


        localStorage.removeItem(
            "authToken"
        );


        localStorage.removeItem(
            "accessToken"
        );


        closeSidebar();


        window.location.replace(
            "/"
        );

    }



    // =================================================
    // TOP LOGOUT
    // =================================================

    const ownerLogout =
        document.getElementById(
            "ownerLogout"
        );


    if (ownerLogout) {

        ownerLogout.addEventListener(
            "click",
            function (event) {

                event.preventDefault();

                logoutOwner();

            }
        );

    }



    // =================================================
    // SIDEBAR LOGOUT
    // =================================================

    const sidebarLogout =
        document.getElementById(
            "sidebarLogout"
        );


    if (sidebarLogout) {

        sidebarLogout.addEventListener(
            "click",
            function (event) {

                event.preventDefault();

                logoutOwner();

            }
        );

    }

})();

</script>