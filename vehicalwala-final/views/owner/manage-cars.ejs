<%- include('../partials/head', { title: title || 'Manage Cars' }) %>

<%- include('nav') %>

<div class="flex">

    <%- include('sidebar') %>

    <main class="owner-content flex-1 p-4 md:p-8 bg-slate-50 min-h-screen">

        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

            <div>
                <h1 class="text-2xl font-bold text-gray-800">
                    Manage Cars
                </h1>

                <p class="text-gray-500 mt-1">
                    View, edit and manage all your vehicles
                </p>
            </div>

            <a
                href="/owner/add-car"
                class="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-lg inline-flex items-center justify-center"
            >
                + Add Car
            </a>

        </div>


        <!-- Vehicle Count -->
        <div class="mt-6">
            <p class="text-gray-600">
                Total Vehicles:
                <b id="ownerCarCount">0</b>
            </p>
        </div>


        <!-- Vehicle List -->
        <div
            id="ownerCars"
            class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mt-6"
        >
            <!-- owner.js will load vehicles here -->
        </div>

    </main>

</div>


<!-- =========================
     EDIT VEHICLE MODAL
========================= -->

<div
    id="editModal"
    class="hidden fixed inset-0 bg-black/50 z-50 items-center justify-center p-4"
>

    <form
        id="editCarForm"
        class="bg-white rounded-xl p-6 w-full max-w-2xl max-h-[90vh] overflow-auto"
    >

        <div class="flex items-center justify-between mb-4">

            <h2 class="text-xl font-bold text-gray-800">
                Edit Vehicle
            </h2>

            <button
                type="button"
                id="closeEdit"
                class="text-gray-500 hover:text-black text-xl"
            >
                ✕
            </button>

        </div>


        <input
            type="hidden"
            name="id"
        >


        <div
            id="editFields"
            class="grid md:grid-cols-2 gap-4"
        >
        </div>


        <button
            type="submit"
            class="mt-6 w-full bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-lg font-medium"
        >
            Update Vehicle
        </button>

    </form>

</div>


<script src="/js/owner.js"></script>

</body>
</html>